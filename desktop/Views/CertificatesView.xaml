<UserControl x:Class="SkillSwap.Desktop.Views.CertificatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.1*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Style="{StaticResource CarteStyle}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource ChampStyle}" Margin="0,0,10,0"
                             Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Rechercher"
                            Style="{StaticResource BoutonPrimaireStyle}"
                            Command="{Binding RechercherCommand}" />
                    <Button Grid.Column="2" Content="Rafraîchir"
                            Style="{StaticResource BoutonSecondaireStyle}"
                            Command="{Binding RafraichirCommand}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CarteStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Certificats}"
                          SelectedItem="{Binding CertificatSelectionne, Mode=TwoWay}"
                          Style="{StaticResource TableauStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Identifiant" Binding="{Binding IdentifiantUnique}" Width="*" />
                        <DataGridTextColumn Header="Compétence"  Binding="{Binding CompetenceAcquise}" Width="1.6*" />
                        <DataGridTextColumn Header="Apprenant"   Binding="{Binding ApprenantNomComplet}" Width="*" />
                        <DataGridTextColumn Header="Statut"      Binding="{Binding Statut}" Width="100" />
                        <DataGridTextColumn Header="Délivré le"  Binding="{Binding DateDelivrance, StringFormat=dd/MM/yyyy}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource CarteStyle}"
                        Visibility="{Binding ADesMessages, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageEstErreur}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AlertBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border Style="{StaticResource CarteStyle}"
                        IsEnabled="{Binding UnCertificatEstSelectionne}">
                    <StackPanel>
                        <TextBlock Text="CERTIFICAT SÉLECTIONNÉ" Style="{StaticResource LabelSectionStyle}" />

                        <TextBlock Text="Identifiant unique" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding CertificatSelectionne.IdentifiantUnique}"
                                   Style="{StaticResource MonoStyle}" Margin="0,0,0,8" />

                        <TextBlock Text="Code de vérification" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding CertificatSelectionne.CodeVerification}"
                                   Style="{StaticResource MonoStyle}" Margin="0,0,0,8" />

                        <TextBlock Text="Compétence acquise" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding CertificatSelectionne.CompetenceAcquise}"
                                   TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <TextBlock Text="Apprenant" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding CertificatSelectionne.ApprenantNomComplet}" Margin="0,0,0,8" />

                        <TextBlock Text="Formateur" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding CertificatSelectionne.FormateurNomComplet}" Margin="0,0,0,8" />

                        <TextBlock Text="Statut" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding CertificatSelectionne.Statut}"
                                   FontWeight="SemiBold" Margin="0,0,0,16" />

                        <Button Content="Révoquer le certificat"
                                Style="{StaticResource BoutonDangerStyle}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Command="{Binding RevoquerCommand}" />

                        <Button Content="Régénérer le certificat"
                                Style="{StaticResource BoutonSecondaireStyle}"
                                HorizontalAlignment="Stretch" Margin="0"
                                Command="{Binding RegenererCommand}" />

                        <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Text="La régénération invalide l'ancien certificat, qui reste consultable avec la mention « REMPLACE ». Toute action est journalisée avec son auteur." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
