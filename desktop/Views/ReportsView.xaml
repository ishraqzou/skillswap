<UserControl x:Class="SkillSwap.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.1*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Style="{StaticResource CarteStyle}" Padding="14">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Rafraîchir" Style="{StaticResource BoutonSecondaireStyle}"
                            Command="{Binding RafraichirCommand}" />
                    <CheckBox Content="Afficher aussi les signalements clôturés"
                              VerticalAlignment="Center" Margin="12,0,0,0"
                              IsChecked="{Binding AfficherTraites, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CarteStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Signalements}"
                          SelectedItem="{Binding SignalementSelectionne, Mode=TwoWay}"
                          Style="{StaticResource TableauStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Auteur" Binding="{Binding AuteurNomComplet}" Width="*" />
                        <DataGridTextColumn Header="Cible"  Binding="{Binding CibleAffichee}" Width="150" />
                        <DataGridTextColumn Header="Motif"  Binding="{Binding Motif}" Width="2*" />
                        <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="110" />
                        <DataGridTextColumn Header="Date"   Binding="{Binding DateCreation, StringFormat=dd/MM/yyyy}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource CarteStyle}"
                        Visibility="{Binding ADesMessages, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageEstErreur}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AlertBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border Style="{StaticResource CarteStyle}"
                        IsEnabled="{Binding UnSignalementEstSelectionne}">
                    <StackPanel>
                        <TextBlock Text="INSTRUCTION DU SIGNALEMENT" Style="{StaticResource LabelSectionStyle}" />

                        <TextBlock Text="Auteur" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding SignalementSelectionne.AuteurNomComplet}"
                                   FontWeight="SemiBold" Margin="0,0,0,8" />

                        <TextBlock Text="Contenu ciblé" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding SignalementSelectionne.CibleAffichee}"
                                   FontWeight="SemiBold" Margin="0,0,0,8" />

                        <TextBlock Text="Motif du signalement" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding SignalementSelectionne.Motif}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Text="Décision motivée (obligatoire)" FontWeight="SemiBold"
                                   Foreground="{StaticResource NavyBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource ChampStyle}" Height="80"
                                 TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14"
                                 Text="{Binding MotifDecision, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Signalement FONDÉ — appliquer et clôturer"
                                Style="{StaticResource BoutonDangerStyle}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Command="{Binding CloturerFondeCommand}" />

                        <Button Content="Signalement NON FONDÉ — clôturer"
                                Style="{StaticResource BoutonSecondaireStyle}"
                                HorizontalAlignment="Stretch" Margin="0"
                                Command="{Binding CloturerNonFondeCommand}" />

                        <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Text="Un signalement fondé visant une compétence entraîne son archivage automatique. Toute décision est journalisée avec son auteur et sa date." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
