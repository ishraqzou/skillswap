<UserControl x:Class="SkillSwap.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1.1*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Style="{StaticResource CarteStyle}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource ChampStyle}"
                             Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,10,0" />
                    <Button Grid.Column="1" Content="Rechercher"
                            Style="{StaticResource BoutonPrimaireStyle}"
                            Command="{Binding RechercherCommand}" />
                    <Button Grid.Column="2" Content="Rafraîchir"
                            Style="{StaticResource BoutonSecondaireStyle}"
                            Command="{Binding RafraichirCommand}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CarteStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Utilisateurs}"
                          SelectedItem="{Binding UtilisateurSelectionne, Mode=TwoWay}"
                          Style="{StaticResource TableauStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom"     Binding="{Binding NomComplet}" Width="*" />
                        <DataGridTextColumn Header="E-mail"  Binding="{Binding Email}" Width="1.6*" />
                        <DataGridTextColumn Header="Ville"   Binding="{Binding Ville}" Width="110" />
                        <DataGridTextColumn Header="Points"  Binding="{Binding SoldePoints}" Width="70" />
                        <DataGridTextColumn Header="Note"    Binding="{Binding NoteAffichee}" Width="80" />
                        <DataGridTextColumn Header="Statut"  Binding="{Binding Statut}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <Border Grid.Column="1" Width="16" Background="Transparent" />

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource CarteStyle}"
                        Visibility="{Binding ADesMessages, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageEstErreur}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AlertBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border Style="{StaticResource CarteStyle}"
                        IsEnabled="{Binding UnUtilisateurEstSelectionne}">
                    <StackPanel>
                        <TextBlock Text="COMPTE SÉLECTIONNÉ" Style="{StaticResource LabelSectionStyle}" />
                        <TextBlock Text="{Binding UtilisateurSelectionne.NomComplet}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource NavyBrush}" />
                        <TextBlock Text="{Binding UtilisateurSelectionne.Email}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,2,0,12" />

                        <Button Content="Suspendre / Réactiver le compte"
                                Style="{StaticResource BoutonSecondaireStyle}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding BasculerStatutCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CarteStyle}"
                        IsEnabled="{Binding UnUtilisateurEstSelectionne}">
                    <StackPanel>
                        <TextBlock Text="AJUSTEMENT MANUEL DES POINTS" Style="{StaticResource LabelSectionStyle}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Réservé aux cas exceptionnels (fraude, litige, récompense). Un motif est obligatoire et l'opération est journalisée." />

                        <TextBlock Text="Montant (positif ou négatif)" FontWeight="SemiBold"
                                   Foreground="{StaticResource NavyBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource ChampStyle}" Margin="0,0,0,10"
                                 Text="{Binding MontantAjustement, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Motif (obligatoire)" FontWeight="SemiBold"
                                   Foreground="{StaticResource NavyBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource ChampStyle}" Height="64"
                                 TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"
                                 Text="{Binding MotifAjustement, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Appliquer l'ajustement"
                                Style="{StaticResource BoutonActionStyle}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding AjusterPointsCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CarteStyle}">
                    <StackPanel>
                        <TextBlock Text="HISTORIQUE DES POINTS" Style="{StaticResource LabelSectionStyle}" />
                        <DataGrid ItemsSource="{Binding HistoriquePoints}"
                                  Style="{StaticResource TableauStyle}" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date"    Binding="{Binding DateCreation, StringFormat=dd/MM/yyyy}" Width="90" />
                                <DataGridTextColumn Header="Montant" Binding="{Binding MontantAffiche}" Width="70" />
                                <DataGridTextColumn Header="Type"    Binding="{Binding TypeAffiche}" Width="*" />
                                <DataGridTextColumn Header="Motif"   Binding="{Binding Motif}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
