<Window x:Class="SkillSwap.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkillSwap — Administration"
        Height="520" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource CreamBrush}">

    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,28">
            <Border Width="56" Height="56" CornerRadius="28"
                    Background="{StaticResource NavyBrush}" HorizontalAlignment="Center">
                <TextBlock Text="⇄" FontSize="26" Foreground="{StaticResource GoldBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="SkillSwap" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource NavyBrush}"
                       HorizontalAlignment="Center" Margin="0,14,0,2" />
            <TextBlock Text="Espace d'administration" FontSize="13"
                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CarteStyle}">
            <StackPanel>
                <TextBlock Text="Adresse e-mail" FontWeight="SemiBold"
                           Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6" />
                <TextBox Style="{StaticResource ChampStyle}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16" />

                <TextBlock Text="Mot de passe" FontWeight="SemiBold"
                           Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6" />
                <PasswordBox x:Name="ChampMotDePasse"
                             Style="{StaticResource ChampMotDePasseStyle}"
                             Margin="0,0,0,18" />

                <Button Content="Se connecter"
                        Style="{StaticResource BoutonPrimaireStyle}"
                        HorizontalAlignment="Stretch" Margin="0"
                        Click="BoutonConnexion_Click"
                        IsDefault="True" />

                <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="6"
                        Background="#FFF7E3E3"
                        Visibility="{Binding ADesErreurs, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding MessageErreur}" TextWrapping="Wrap"
                               Foreground="{StaticResource AlertBrush}" FontSize="12" />
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                   Style="{StaticResource MutedTextStyle}" TextAlignment="Center"
                   Text="Accès réservé aux administrateurs de la plateforme."/>
    </Grid>
</Window>
