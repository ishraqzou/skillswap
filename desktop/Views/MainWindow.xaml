<Window x:Class="SkillSwap.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SkillSwap.Desktop.ViewModels"
        xmlns:views="clr-namespace:SkillSwap.Desktop.Views"
        Title="SkillSwap — Administration"
        Height="760" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CreamBrush}">

    <Window.Resources>
        <!-- Association declarative ViewModel => Vue (patron MVVM) -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}">
            <views:UsersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CertificatesViewModel}">
            <views:CertificatesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation laterale -->
        <Border Grid.Column="0" Background="{StaticResource NavyDarkBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource GoldBrush}">
                            <TextBlock Text="⇄" FontSize="15" Foreground="{StaticResource NavyDarkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SkillSwap" FontSize="17" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Administration" FontSize="10.5" Foreground="#FF8A97A8" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                    <Border Height="1" Background="#33FFFFFF" Margin="12,8" />
                    <Button Content="Déconnexion" Style="{StaticResource BoutonNavStyle}"
                            Command="{Binding DeconnexionCommand}" />
                </StackPanel>

                <StackPanel>
                    <Button Content="Tableau de bord"  Style="{StaticResource BoutonNavStyle}" Command="{Binding AfficherDashboardCommand}" />
                    <Button Content="Utilisateurs"     Style="{StaticResource BoutonNavStyle}" Command="{Binding AfficherUtilisateursCommand}" />
                    <Button Content="Signalements"     Style="{StaticResource BoutonNavStyle}" Command="{Binding AfficherSignalementsCommand}" />
                    <Button Content="Certificats"      Style="{StaticResource BoutonNavStyle}" Command="{Binding AfficherCertificatsCommand}" />
                    <Button Content="Statistiques"     Style="{StaticResource BoutonNavStyle}" Command="{Binding AfficherStatistiquesCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Zone de contenu -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="0,0,0,1" Padding="24,16">
                <Grid>
                    <TextBlock Text="{Binding TitreSection}" Style="{StaticResource TitreSectionStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NomAdministrateur}" VerticalAlignment="Center"
                                   Margin="0,0,12,0" Foreground="{StaticResource InkBrush}" FontSize="13" />
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource NavyDarkBrush}">
                            <TextBlock Text="{Binding InitialesAdministrateur}" Foreground="White"
                                       FontWeight="SemiBold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Content="{Binding VueCourante}" Margin="24" />
        </DockPanel>
    </Grid>
</Window>
