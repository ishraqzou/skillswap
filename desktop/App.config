<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      Chaîne de connexion à la base MySQL/MariaDB partagée avec l'application
      web (Tâche 18). Sous XAMPP, l'utilisateur par défaut est "root" sans
      mot de passe ; à adapter impérativement en production.
    -->
    <add name="SkillSwapDb"
         connectionString="Server=127.0.0.1;Port=3306;Database=skillswap;Uid=root;Pwd=;CharSet=utf8mb4;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
</configuration>
